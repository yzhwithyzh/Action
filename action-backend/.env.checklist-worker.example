# 报告规范校验 Worker 环境文件示例
#
# 复制成 .env.checklist-worker，start_checklist_worker.sh 会 `set -a` 载入
# （纯 KEY=VALUE 的 shell 语法，别写成 .env.prod 那种 `KEY = 'value'`——source 不了）。
#
# ⚠️ 这里的值后端进程也要有一份一样的：队列名/Redis 对不上，就会一个投一条队列、
#    一个守另一条，官网上提交的校验永远排队没人取。systemd 部署时让两个 unit 指同一个
#    EnvironmentFile。`./status_checklist_worker.sh` 打印的队列长度就是用来验这件事的。

# ---- Redis（不填则 localhost:6379/0；注意与 .env.* 里的 REDIS_DATABASE 是两回事）----
CHECKLIST_WORKER_REDIS_HOST=127.0.0.1
CHECKLIST_WORKER_REDIS_PORT=6379
CHECKLIST_WORKER_REDIS_DB=0
#CHECKLIST_WORKER_REDIS_PASSWORD=

# ---- 队列与并发 ----
CHECKLIST_WORKER_QUEUE_NAME=checklist_review
CHECKLIST_WORKER_MAX_CONCURRENT_SESSIONS=2
CHECKLIST_WORKER_MAX_CONCURRENT_LLM=12
CHECKLIST_WORKER_LOG_LEVEL=INFO

# ---- 优雅关闭：stop 脚本默认等 330s，比这个值大一点 ----
#CHECKLIST_WORKER_SHUTDOWN_TIMEOUT=300

# ---- 模型 ----
# 本工具**不设环境变量兜底模型**：官网前台在调它，配置必须从后台「AI 模型管理」可见可控。
# 模型池取自 ai_models 表（启用中 + 配了 API key），按 model_sort「粘性 + 出错切换」。

# ---- 运行环境与解释器（也可以在命令行里临时给）----
# 不填＝dev（读 .env.dev）；上生产库改成 prod。必须和后端服务指同一套库 ——
# worker 要从库里取 checklist 条目（action_guideline_item）与模型池。
#APP_ENV=dev
#CHECKLIST_WORKER_PYTHON=/path/to/action-backend/.venv/bin/python
