# SRD Worker 环境文件示例
#
# 复制成 .env.srd-worker，start_srd_worker.sh 会 `set -a` 载入（纯 KEY=VALUE 的 shell 语法，
# 别写成 .env.prod 那种 `KEY = 'value'`——source 不了）。
#
# ⚠️ 这里的值后端进程也要有一份一样的：队列名/Redis 对不上，就会一个投一条队列、
#    一个守另一条，任务永远排队没人取。systemd 部署时让两个 unit 指同一个 EnvironmentFile。

# ---- Redis（不填则 localhost:6379/0；注意与 .env.* 里的 REDIS_DATABASE 是两回事）----
SRD_WORKER_REDIS_HOST=127.0.0.1
SRD_WORKER_REDIS_PORT=6379
SRD_WORKER_REDIS_DB=0
#SRD_WORKER_REDIS_PASSWORD=

# ---- 队列与并发 ----
SRD_WORKER_QUEUE_NAME=srd_assessment
SRD_WORKER_MAX_CONCURRENT_SESSIONS=2
SRD_WORKER_MAX_CONCURRENT_LLM=16
SRD_WORKER_LOG_LEVEL=INFO

# ---- 优雅关闭：stop 脚本默认等 330s，比这个值大一点 ----
#SRD_WORKER_SHUTDOWN_TIMEOUT=300

# ---- 兜底模型：ai_models 表里一个可用模型都没有时才生效 ----
#SRD_PROVIDER=deepseek
#SRD_MODEL=deepseek-chat
#SRD_API_KEY=sk-xxx
#SRD_BASE_URL=

# ---- 运行环境与解释器（也可以在命令行里临时给）----
# 不填＝dev（读 .env.dev）；上生产库改成 prod
#APP_ENV=dev
#SRD_WORKER_PYTHON=/path/to/action-backend/.venv/bin/python
