# 复制为 .env 并按需修改；CLI 读的是环境变量，本文件仅作说明
# （引擎不自动加载 .env，请用 `set -a; . ./.env; set +a` 或你惯用的方式导出）

# 提供商：OpenAI / DeepSeek / DashScope / Moonshot / SiliconFlow / ZhipuAI /
#         OpenRouter / Anthropic / Google，其余 OpenAI 兼容端点填 OpenAI + BASE_URL
SRD_PROVIDER=DeepSeek
SRD_MODEL=deepseek-v4-flash-260425
# 真实 key 只写进本机的 .env（已被 .gitignore 排除），不要填回本文件
SRD_API_KEY=<你的 API Key>
# 留空则使用 provider 的默认端点（见 adapters/langchain_client.py）
SRD_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 可选：输出上限
SRD_MAX_TOKENS=
